@page
@model NexusOps.Web.Pages.Account.LoginModel
@{ ViewData["Title"] = "Prijava"; }

<div class="page-head"><div><span class="eyebrow">NexusOps identitet</span><h1>Prijava</h1><p>Prijavi se svojim poslovnim računom.</p></div></div>
<section class="panel form-panel login-panel"><form method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><p><label asp-for="Email">E-mail</label><input asp-for="Email" type="email" autocomplete="email" autofocus /></p><p><label asp-for="Password">Lozinka</label><span class="password-field"><input asp-for="Password" type="password" autocomplete="current-password" /><button class="password-toggle" type="button" aria-label="Prikaži lozinku" title="Prikaži lozinku">👁</button></span></p><input type="hidden" asp-for="ReturnUrl" /><button class="btn btn-primary" type="submit">Prijavi se</button></form></section>

@section Scripts {
    <script>
        document.querySelector('.password-toggle')?.addEventListener('click', function () {
            const input = document.getElementById('@Html.IdFor(model => model.Password)');
            const visible = input.type === 'text';
            input.type = visible ? 'password' : 'text';
            this.textContent = visible ? '👁' : '◉';
            this.setAttribute('aria-label', visible ? 'Prikaži lozinku' : 'Sakrij lozinku');
        });
    </script>
}
