@page
@model NexusOps.Web.Pages.Assets.IndexModel
@{ ViewData["Title"]="Strojevi"; }
<div class="page-head"><div><span class="eyebrow">Imovina</span><h1>Strojevi</h1><p>Registar opreme i trenutačno stanje.</p></div><a class="btn btn-primary" asp-page="Create">+ Novi stroj</a></div>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Šifra</th><th>Stroj</th><th>Lokacija</th><th>Status</th></tr></thead><tbody>@if (!Model.Assets.Any()){<tr><td colspan="4" class="empty-row">Nema strojeva. <a asp-page="Create">Dodaj prvi stroj</a>.</td></tr>}else{foreach(var asset in Model.Assets){<tr><td>@asset.Code</td><td><strong>@asset.Name</strong></td><td>@asset.Location</td><td>@asset.Status</td></tr>}}</tbody></table></div></section>
