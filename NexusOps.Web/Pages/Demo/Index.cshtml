@page
@model NexusOps.Web.Pages.Demo.IndexModel
@{ ViewData["Title"] = "Javni demo"; }

<div class="page-head"><div><span class="eyebrow">Siguran javni prikaz</span><h1>Voice demo</h1><p>Pokreni vizualnu simulaciju poziva za radni nalog. Twilio, telefon i poslovni podaci nisu korišteni.</p></div></div>
@if (TempData["Success"] is string success) { <p class="notice success">@success</p> }

<style>
    .demo-grid { display:grid; grid-template-columns:.8fr 1.2fr; gap:18px; }.demo-call,.demo-live { padding:25px; }.call-state { display:flex; align-items:center; gap:10px; margin:16px 0; color:#aef8cf; font:700 .76rem ui-monospace,monospace; letter-spacing:.08em; text-transform:uppercase; }.call-dot { width:10px; height:10px; border-radius:50%; background:#667b94; box-shadow:0 0 0 0 rgba(118,217,255,0); }.call-dot.active { background:#76d9ff; animation:demo-pulse 1.1s infinite; }.call-dot.complete { background:#65e6a3; }.call-meta { display:grid; gap:11px; margin:21px 0; }.call-meta div { display:flex; justify-content:space-between; gap:10px; padding-bottom:10px; border-bottom:1px solid rgba(142,191,230,.12); color:#dcecf9; }.call-meta span { color:var(--muted); font-size:.8rem; }.demo-live { min-height:360px; }.transcript { display:grid; gap:12px; margin-top:18px; }.line { display:grid; grid-template-columns:82px minmax(0,1fr); gap:12px; padding:11px 0; border-bottom:1px solid rgba(142,191,230,.11); animation:demo-arrive .35s ease-out; }.line b { color:#76d9ff; font:700 .67rem ui-monospace,monospace; letter-spacing:.08em; text-transform:uppercase; }.line.user b { color:#ffc766; }.line.system b { color:#9ab0c8; }.line p { margin:0; color:#e4f3ff; line-height:1.45; }.live-empty { display:grid; place-items:center; min-height:230px; color:var(--muted); text-align:center; }.call-duration { color:#aef8cf; font:700 .9rem ui-monospace,monospace; } @@keyframes demo-pulse { 50% { box-shadow:0 0 0 9px rgba(118,217,255,0); } } @@keyframes demo-arrive { from { opacity:0; transform:translateY(7px); } to { opacity:1; transform:none; } } @@media (max-width:900px) { .demo-grid { grid-template-columns:1fr; } }
</style>
<section class="demo-grid">
    <article class="panel demo-call"><span class="eyebrow">RN-DEMO-001</span><h2 style="margin-top:8px">Pregled automatizirane pakirne linije</h2><div class="call-state"><i id="call-dot" class="call-dot"></i><span id="call-state">Spremno za simulaciju</span></div><div class="call-meta"><div><span>Kontakt</span><strong>Demo tehničar</strong></div><div><span>Kanal</span><strong>Telefonski poziv · simulacija</strong></div><div><span>Trajanje</span><strong id="call-duration" class="call-duration">00:00</strong></div></div><form id="demo-call-form" method="post" asp-page-handler="StartCall"><button id="start-demo-call" class="btn btn-primary" type="submit">Simuliraj telefonski poziv</button></form><p class="form-hint">Ovaj prikaz radi samo u pregledniku; stvarni poziv nije moguć iz javnog dema.</p></article>
    <article class="panel demo-live"><div class="panel-head"><h2>Živi tijek poziva</h2><span id="live-label">Nema aktivne simulacije</span></div><div id="transcript" class="transcript"><div class="live-empty">Klikni “Simuliraj Twilio poziv” za prikaz tijeka poziva, statusa i kratkog transkripta.</div></div></article>
</section>
<section class="panel table-panel" style="margin-top:18px"><div class="panel-head"><h2>Ova demo sesija</h2><span>@Model.Notifications.Count simulacija</span></div><div class="table-wrap"><table><thead><tr><th>Kanal</th><th>Poruka</th><th>Vrijeme</th></tr></thead><tbody>@if (Model.Notifications.Count == 0) { <tr><td colspan="3" class="empty-row">Još nema simuliranih poziva.</td></tr> } @foreach (var notification in Model.Notifications) { <tr><td>@notification.Channel</td><td>@notification.Message</td><td>@notification.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy. HH:mm")</td></tr> }</tbody></table></div></section>

@section Scripts {
<script>
(() => {
    const form = document.getElementById('demo-call-form');
    const button = document.getElementById('start-demo-call');
    const state = document.getElementById('call-state');
    const dot = document.getElementById('call-dot');
    const duration = document.getElementById('call-duration');
    const transcript = document.getElementById('transcript');
    const liveLabel = document.getElementById('live-label');
    let running = false, timer, startedAt;
    const addLine = (speaker, text) => {
        if (!transcript.dataset.started) { transcript.innerHTML = ''; transcript.dataset.started = 'true'; }
        const line = document.createElement('div'); line.className = `line ${speaker.toLowerCase()}`;
        line.innerHTML = `<b>${speaker}</b><p>${text}</p>`; transcript.appendChild(line);
    };
    const updateDuration = () => { const seconds = Math.floor((Date.now() - startedAt) / 1000); duration.textContent = `00:${String(seconds).padStart(2, '0')}`; };
    const setState = (text, complete = false) => { state.textContent = text; liveLabel.textContent = text; dot.className = `call-dot ${complete ? 'complete' : 'active'}`; };
    form.addEventListener('submit', async event => {
        event.preventDefault(); if (running) return; running = true; button.disabled = true; button.textContent = 'Simulacija je u tijeku…'; startedAt = Date.now(); updateDuration(); timer = setInterval(updateDuration, 500);
        setState('Biranje broja'); addLine('System', 'Demo sesija poziva je pokrenuta. Nisu korišteni telefonski broj ni vanjski servis.');
        fetch(form.action, { method: 'POST', body: new FormData(form), credentials: 'same-origin' }).catch(() => {});
        setTimeout(() => { setState('Zvonjava'); addLine('System', 'Calling Demo Technician for work order RN-DEMO-001.'); }, 900);
        setTimeout(() => { setState('Poziv povezan'); addLine('Agent', 'Hello. This is the NexusOps demo assistant. A maintenance inspection has been assigned.'); }, 2300);
        setTimeout(() => addLine('User', 'Please confirm the work order details.'), 3600);
        setTimeout(() => addLine('Agent', 'Confirmed. The automated packaging line inspection is scheduled and the technician has been notified.'), 4900);
        setTimeout(() => { clearInterval(timer); updateDuration(); setState('Poziv uspješno završen', true); addLine('System', 'Simulation complete. No real call, AI request or cost was incurred.'); button.disabled = false; button.textContent = 'Pokreni novu simulaciju'; running = false; }, 6400);
    });
})();
</script>
}
