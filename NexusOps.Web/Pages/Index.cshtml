@page
@model IndexModel
@{ ViewData["Title"] = "Command Center"; }
<div class="page-head"><div><span class="eyebrow">Operativni pregled</span><h1>Dobro jutro</h1><p>Pregled strojeva, naloga i financija na jednom mjestu.</p></div><div class="actions"><a class="btn secondary-btn" asp-page="/Assets/Create">+ Novi stroj</a><a class="btn btn-primary" asp-page="/WorkOrders/Create">+ Novi radni nalog</a>@if (User.IsInRole("Administrator") || User.IsInRole("Manager")){<a class="btn secondary-btn" asp-page="/Users/Index">+ Novi korisnik</a>}</div></div>
<section class="stat-grid"><article><span>Otvoreni nalozi</span><strong>@Model.Summary.OpenWorkOrders</strong><small>za obradu</small></article><article><span>Hitni nalozi</span><strong>@Model.Summary.CriticalWorkOrders</strong><small>traže pažnju</small></article><article><span>Strojevi za provjeru</span><strong>@Model.Summary.AssetsNeedingAttention</strong><small>potrebna intervencija</small></article><article><span>Završeno ovaj mjesec</span><strong>@Model.Summary.CompletedThisMonth</strong><small>radnih naloga</small></article></section>
<style>
    .dashboard-grid { display:grid; grid-template-columns:1.3fr .7fr; gap:18px; margin-bottom:28px; }.finance-overview,.attention-panel { padding:24px; }.finance-kpis { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin:18px 0 22px; }.finance-kpis div { padding:13px; border:1px solid var(--line); border-radius:8px 18px 8px 8px; background:rgba(118,217,255,.05); }.finance-kpis span { display:block; color:var(--muted); font-size:.72rem; }.finance-kpis strong { display:block; margin-top:6px; color:#f5faff; font-size:1.08rem; }.finance-kpis .expense strong { color:#ffc0c7; }.chart { display:flex; align-items:end; gap:12px; min-height:175px; padding:16px 7px 0; border-top:1px solid var(--line); }.chart-month { display:grid; flex:1; min-width:0; gap:7px; text-align:center; }.chart-bars { display:flex; align-items:end; justify-content:center; gap:4px; height:126px; }.chart-bar { width:min(18px,35%); min-height:3px; border-radius:5px 5px 0 0; }.chart-bar.income { background:linear-gradient(#76d9ff,#4c8fff); }.chart-bar.expense { background:linear-gradient(#ff9da8,#d8556c); }.chart-month small { color:var(--muted); font-size:.68rem; text-transform:uppercase; }.legend { display:flex; gap:14px; color:var(--muted); font-size:.75rem; }.legend i { display:inline-block; width:8px; height:8px; margin-right:5px; border-radius:50%; }.attention-list { display:grid; gap:12px; margin:17px 0; }.attention-item { display:flex; justify-content:space-between; gap:12px; padding:11px 0; border-bottom:1px solid rgba(142,191,230,.12); color:#dcecf9; }.attention-item span { color:var(--muted); font-size:.8rem; }.attention-number { color:#ffc766; font-size:2.7rem; font-weight:780; letter-spacing:-.08em; } @@media (max-width:1000px) { .dashboard-grid,.finance-kpis { grid-template-columns:1fr; } }
</style>
<section class="dashboard-grid"><article class="panel finance-overview"><div class="panel-head"><h2>Financijski puls</h2><a asp-page="/Finance/Index">Financije →</a></div><div class="finance-kpis"><div><span>Stanje računa</span><strong>@Model.Finance.TotalBalance.ToString("N2") EUR</strong></div><div><span>Prihodi ovaj mjesec</span><strong>@Model.Finance.IncomeThisMonth.ToString("N2") EUR</strong></div><div class="expense"><span>Rashodi ovaj mjesec</span><strong>@Model.Finance.ExpenseThisMonth.ToString("N2") EUR</strong></div></div><div class="legend"><span><i style="background:#76d9ff"></i>Prihodi</span><span><i style="background:#ff9da8"></i>Rashodi</span></div><div class="chart" aria-label="Kretanje prihoda i rashoda posljednjih šest mjeseci">@foreach (var month in Model.Months) { <div class="chart-month" title="@month.Label: prihodi @month.Income.ToString("N2") EUR, rashodi @month.Expense.ToString("N2") EUR"><div class="chart-bars"><i class="chart-bar income" style="height:@month.IncomeHeight%"></i><i class="chart-bar expense" style="height:@month.ExpenseHeight%"></i></div><small>@month.Label</small></div> }</div></article><article class="panel attention-panel"><span class="eyebrow">Operativna pažnja</span><div class="attention-number">@Model.LowStockItems</div><h2>stavki na minimumu</h2><p>Provjeri raspoloživost materijala prije dodjele novih radnih naloga.</p><div class="attention-list"><div class="attention-item"><strong>@Model.Summary.CriticalWorkOrders hitnih naloga</strong><span>prioritet</span></div><div class="attention-item"><strong>@Model.Summary.AssetsNeedingAttention strojeva</strong><span>provjera</span></div></div><a class="btn secondary-btn" asp-page="/Inventory/Index">Otvori skladište</a></article></section>
<section class="quick-actions"><a asp-page="/Assets/Create"><strong>▣ Dodaj stroj</strong><span>Unesi opremu u registar</span></a><a asp-page="/WorkOrders/Create"><strong>✓ Otvori radni nalog</strong><span>Prijavi servis ili intervenciju</span></a><a asp-page="/Reports/Index"><strong>◫ Otvori izvještaje</strong><span>Pregled rada i prioriteta</span></a></section>
<section class="panel"><div class="panel-head"><h2>Prioritetni radni nalozi</h2><a asp-page="/WorkOrders/Index">Svi nalozi →</a></div><div class="table-wrap"><table><thead><tr><th>Broj</th><th>Radni nalog</th><th>Prioritet</th><th>Status</th><th>Dodijeljeno</th></tr></thead><tbody>@foreach (var item in Model.WorkOrders) { <tr><td>@item.Number</td><td><strong>@item.Title</strong></td><td><span class="priority @item.Priority.ToString().ToLowerInvariant()">@item.Priority</span></td><td><span class="status @item.Status.ToString().ToLowerInvariant()">@item.Status</span></td><td>@(string.IsNullOrWhiteSpace(item.AssignedTo) ? "Nije dodijeljeno" : item.AssignedTo)</td></tr> }</tbody></table></div></section>
