@page
@model NexusOps.Web.Pages.Inventory.IndexModel
@{ViewData["Title"]="Skladište";var low=Model.Items.Where(x=>x.Available<=x.Minimum).ToArray();}
<div class="page-head"><div><span class="eyebrow">Roba i materijal</span><h1>Skladište</h1><p>Stanje, rezervacije i minimalne količine po skladištu.</p></div></div>
<section class="stat-grid"><article><span>Artikala</span><strong>@Model.Items.Count</strong><small>u aktivnom pregledu</small></article><article><span>Vrijednost zaliha</span><strong>@Model.Items.Sum(x=>x.Value).ToString("N2") €</strong><small>nabavna vrijednost</small></article><article><span>Za naručiti</span><strong>@low.Length</strong><small>ispod minimuma</small></article><article><span>Rezervirano</span><strong>@Model.Items.Sum(x=>x.Reserved).ToString("N0")</strong><small>za radne naloge</small></article></section>
<section class="panel table-panel"><div class="panel-head"><h2>Stanje robe</h2><span>@(low.Length>0?"Potrebna nabava":"Zalihe su uredne")</span></div><div class="table-wrap"><table><thead><tr><th>Skladište</th><th>Šifra</th><th>Artikl</th><th>Dostupno</th><th>Minimum</th><th>Rezervirano</th><th>Vrijednost</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.Warehouse</td><td>@x.Code</td><td><strong>@x.Name</strong></td><td><span class="tag">@x.Available @x.Unit</span></td><td>@x.Minimum @x.Unit</td><td>@x.Reserved @x.Unit</td><td>@x.Value.ToString("N2") €</td></tr>}</tbody></table></div></section>
