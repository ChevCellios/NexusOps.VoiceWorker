@page
@model NexusOps.Web.Pages.MyWork.IndexModel
@{ ViewData["Title"] = "Moji radni nalozi"; }
<div class="page-head"><div><span class="eyebrow">Operativni rad</span><h1>Moji radni nalozi</h1><p>Radni nalozi i evidencija rada povezani s tvojim zaposleničkim računom.</p></div></div>
@if (TempData["Success"] is string success) { <p class="notice success">@success</p> }
@if (Model.Employee is null) { <section class="panel form-panel"><span class="eyebrow">Potrebno povezivanje</span><h2 style="margin-top:8px">Račun još nije povezan sa zaposlenikom</h2><p>Administrator treba povezati tvoj Supabase račun sa zaposlenikom. E-mail zaposlenika mora biti jednak e-mailu za prijavu.</p></section> }
else { <section class="panel form-panel"><span class="eyebrow">@Model.Employee.Name</span><h2 style="margin-top:8px">@Model.Employee.Status</h2><p>@(Model.Employee.ClockedInAt is null ? "Trenutačno nemaš aktivnu evidenciju rada." : $"Rad je pokrenut u {Model.Employee.ClockedInAt.Value.LocalDateTime:HH:mm}.")</p><form method="post" asp-page-handler="@(Model.Employee.ClockedInAt is null ? "Start" : "End")"><button class="btn btn-primary" type="submit">@(Model.Employee.ClockedInAt is null ? "Počni rad" : "Završi rad")</button></form></section><section class="panel table-panel" style="margin-top:18px"><div class="panel-head"><h2>Dodijeljeni nalozi</h2><span>@Model.WorkOrders.Count naloga</span></div><div class="table-wrap"><table><thead><tr><th>Broj</th><th>Nalog</th><th>Prioritet</th><th>Rok</th><th>Status</th><th></th></tr></thead><tbody>@if (Model.WorkOrders.Count == 0) { <tr><td colspan="6" class="empty-row">Trenutačno nemaš dodijeljenih radnih naloga.</td></tr> } @foreach (var order in Model.WorkOrders) { <tr><td>@order.Number</td><td><strong>@order.Title</strong></td><td><span class="priority @order.Priority.ToString().ToLowerInvariant()">@order.Priority</span></td><td>@(order.DueAt?.LocalDateTime.ToString("dd.MM. HH:mm") ?? "—")</td><td><span class="status @order.Status.ToString().ToLowerInvariant()">@order.Status</span></td><td><a class="btn secondary-btn" asp-page="/WorkOrders/Details" asp-route-id="@order.Id">Otvori</a></td></tr> }</tbody></table></div></section> }
