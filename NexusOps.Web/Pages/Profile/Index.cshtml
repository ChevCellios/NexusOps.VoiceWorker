@page
@model NexusOps.Web.Pages.Profile.IndexModel
@{ ViewData["Title"] = "Moj profil"; }

<div class="page-head"><div><span class="eyebrow">NexusOps identitet</span><h1>Moj profil</h1><p>Pregled prijavljenog računa, uloge i ovlasti u aplikaciji.</p></div></div>
<style>.profile-grid { display:grid; grid-template-columns:.8fr 1.2fr; gap:18px; }.profile-card { padding:25px; }.profile-avatar { display:grid; place-items:center; width:58px; height:58px; margin-bottom:17px; border-radius:18px 5px 18px 5px; color:#06101e; background:linear-gradient(135deg,var(--cyan),#b7f2ff); font-size:1.4rem; font-weight:850; }.profile-email { color:#e7f5ff; overflow-wrap:anywhere; }.permission-list { display:grid; gap:10px; margin:18px 0 0; padding:0; list-style:none; }.permission-list li { padding:12px 14px; border-left:3px solid var(--green); border-radius:4px 12px 12px 4px; color:#d8ebfa; background:rgba(101,230,163,.06); }.role-pill { display:inline-flex; margin-top:13px; padding:7px 11px; border-radius:999px; color:#d4ecff; background:rgba(118,217,255,.1); font:700 .72rem ui-monospace,monospace; letter-spacing:.08em; text-transform:uppercase; } @@media (max-width:800px) { .profile-grid { grid-template-columns:1fr; } }</style>
<section class="profile-grid"><article class="panel profile-card"><div class="profile-avatar">@Model.Email[..Math.Min(1, Model.Email.Length)].ToUpperInvariant()</div><span class="eyebrow">Prijavljeni račun</span><h2 style="margin-top:8px">@Model.Email</h2><p class="profile-email">Račun je potvrđen kroz Supabase Auth i aktivan je za trenutačnu NexusOps organizaciju.</p><span class="role-pill">@Model.Role</span></article><article class="panel profile-card"><span class="eyebrow">Tvoja uloga</span><h2 style="margin-top:8px">@Model.Role</h2><p>@Model.RoleDescription</p><ul class="permission-list">@foreach (var permission in Model.Permissions) { <li>@permission</li> }</ul></article></section>
