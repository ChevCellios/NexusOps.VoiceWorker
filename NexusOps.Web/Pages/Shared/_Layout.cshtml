<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · NexusOps</title>
    <style>
        :root { --space:#050b1c; --panel:#0c1730; --line:rgba(113,211,255,.2); --text:#edf6ff; --muted:#9ab0c8; --cyan:#76d9ff; --amber:#ffc766; --green:#65e6a3; }
        * { box-sizing:border-box; } html { min-height:100%; background:var(--space); } body { min-height:100vh; margin:0; color:var(--text); background:radial-gradient(circle at 72% -12%,#203c72 0,transparent 29rem),radial-gradient(circle at 11% 86%,#0f405d 0,transparent 32rem),var(--space); font-family:Inter,ui-sans-serif,system-ui,sans-serif; } body::before { content:""; position:fixed; inset:0; z-index:-1; opacity:.33; background-image:radial-gradient(#e4f6ff 1px,transparent 1px); background-size:77px 77px; } a { color:inherit; text-decoration:none; }
        .shell { display:grid; grid-template-columns:265px minmax(0,1fr); min-height:100vh; }.side { display:flex; flex-direction:column; padding:24px 16px 18px; border-right:1px solid var(--line); background:linear-gradient(180deg,rgba(8,17,41,.97),rgba(8,14,34,.83)); }.brand { display:flex; align-items:center; gap:10px; margin:0 9px 38px; color:#f7fbff; font-size:1.35rem; font-weight:780; letter-spacing:-.045em; }.brand b { display:grid; place-items:center; width:34px; height:34px; border-radius:11px 3px 11px 3px; color:#06101e; background:linear-gradient(135deg,var(--cyan),#b7f2ff); box-shadow:0 0 22px rgba(118,217,255,.3); } nav { display:grid; gap:7px; } nav a { padding:12px 13px; border-radius:9px 22px 22px 9px; color:var(--muted); font-size:.93rem; font-weight:650; transition:.2s ease; } nav a:hover { color:var(--text); background:rgba(118,217,255,.12); transform:translateX(3px); } nav a:last-child { margin-top:17px; color:#ffd99d; border:1px solid rgba(255,199,102,.22); background:rgba(255,199,102,.06); }.side-foot { margin:auto 10px 0; padding-top:18px; border-top:1px solid var(--line); color:#cee0ef; font:700 .73rem/1.7 ui-monospace,monospace; letter-spacing:.05em; text-transform:uppercase; }.side-foot span { color:#64809f; font-size:.64rem; }
        main { min-width:0; } header { display:flex; justify-content:space-between; align-items:center; gap:18px; min-height:76px; padding:16px clamp(22px,4vw,58px); border-bottom:1px solid var(--line); background:rgba(5,11,28,.56); backdrop-filter:blur(16px); color:var(--muted); font-size:.82rem; }.header-nav { display:flex; align-items:center; gap:16px; color:#d9ecfa; font-weight:700; }.back-button { border:1px solid rgba(118,217,255,.24); border-radius:6px 16px 16px 6px; padding:8px 11px; color:var(--cyan); background:rgba(118,217,255,.07); cursor:pointer; font:inherit; }.user { display:inline-block; margin-left:13px; padding:6px 10px; border-radius:999px; color:#aef8cf; background:rgba(101,230,163,.09); }.content { max-width:1500px; margin:auto; padding:clamp(28px,5vw,66px); }.page-head { display:flex; justify-content:space-between; align-items:flex-end; gap:22px; margin-bottom:30px; }.eyebrow { color:var(--cyan); font:700 .69rem/1.2 ui-monospace,monospace; letter-spacing:.15em; text-transform:uppercase; }h1 { margin:8px 0; color:#f5faff; font-size:clamp(2rem,4vw,3.35rem); line-height:1.02; letter-spacing:-.065em; }h2 { margin:0; font-size:1.02rem; }p { color:var(--muted); line-height:1.6; }.actions { display:flex; flex-wrap:wrap; gap:10px; }
        .btn { display:inline-flex; align-items:center; justify-content:center; min-height:42px; padding:10px 15px; border:1px solid transparent; border-radius:7px 18px 18px 7px; font-size:.85rem; font-weight:760; transition:.18s ease; }.btn:hover { transform:translateY(-2px); }.btn-primary { color:#071222; background:linear-gradient(115deg,var(--cyan),#9dbdff); box-shadow:0 9px 24px rgba(80,166,255,.24); }.secondary-btn { color:#d8ecfb; border-color:rgba(118,217,255,.32); background:rgba(118,217,255,.07); }.stat-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; margin-bottom:28px; }.stat-grid article { position:relative; overflow:hidden; min-height:150px; padding:20px; border:1px solid var(--line); border-radius:10px 28px 10px 10px; background:linear-gradient(135deg,rgba(19,37,75,.93),rgba(9,20,45,.84)); }.stat-grid article::after { content:""; position:absolute; top:0; right:0; width:42px; height:4px; background:var(--cyan); }.stat-grid article:nth-child(2)::after { background:#ff6b7a; }.stat-grid article:nth-child(3)::after { background:var(--amber); }.stat-grid article:nth-child(4)::after { background:var(--green); }.stat-grid span,.stat-grid small { display:block; color:var(--muted); font-size:.77rem; }.stat-grid strong { display:block; margin:9px 0 2px; color:white; font-size:2.4rem; letter-spacing:-.07em; }.quick-actions { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-bottom:28px; }.quick-actions a { display:grid; gap:5px; padding:18px 20px; border-left:4px solid var(--cyan); border-radius:5px 15px 15px 5px; background:rgba(118,217,255,.075); }.quick-actions span { color:var(--muted); font-size:.8rem; }
        .panel { overflow:hidden; border:1px solid var(--line); border-radius:12px 34px 12px 12px; background:rgba(10,23,50,.78); box-shadow:0 20px 40px rgba(0,0,0,.16); }.panel-head { display:flex; justify-content:space-between; align-items:center; gap:16px; padding:18px 22px; border-bottom:1px solid var(--line); }.panel-head a,.empty-row a { color:var(--cyan); font-size:.83rem; font-weight:700; }.table-wrap { overflow-x:auto; }table { width:100%; border-collapse:collapse; }th,td { padding:15px 20px; border-bottom:1px solid rgba(142,191,230,.1); text-align:left; white-space:nowrap; }th { color:#7ea3c4; font:700 .67rem/1 ui-monospace,monospace; letter-spacing:.09em; text-transform:uppercase; }td { color:#c6d7e8; font-size:.88rem; }tbody tr:hover { background:rgba(118,217,255,.055); }td a { color:#dff5ff; }.empty-row { padding:34px; text-align:center; color:var(--muted); }.priority,.status { display:inline-flex; padding:5px 9px; border-radius:999px; font-size:.7rem; font-weight:750; }.priority.critical { color:#ffd0d6; background:rgba(255,107,122,.13); }.priority.high,.status.new,.status.waitingparts { color:#ffe4b3; background:rgba(255,199,102,.12); }.priority.normal,.status.inprogress,.status.assigned { color:#d4ecff; background:rgba(118,217,255,.1); }.status.completed { color:#b7ffd7; background:rgba(101,230,163,.11); }form p { margin:0 0 17px; }label { display:inline-block; margin-bottom:7px; color:#cfe7fa; font-size:.84rem; font-weight:700; }input,select,textarea { border:1px solid rgba(118,217,255,.25); border-radius:6px 14px 14px 6px; color:#eff8ff; background:rgba(3,12,29,.72); font:inherit; }input:focus,select:focus,textarea:focus { outline:0; border-color:var(--cyan); box-shadow:0 0 0 3px rgba(118,217,255,.12); }option { color:#10203f; }hr { border:0; border-top:1px solid var(--line); margin:22px 0; }
        .form-panel,.detail-panel { padding:25px; }.form-panel { max-width:900px; }.form-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:2px 18px; }.form-wide { grid-column:1 / -1; }.form-grid input,.form-grid select,.form-grid textarea,.status-form select,.status-form input { width:100%; padding:11px 13px; }.form-grid textarea { resize:vertical; }.validation-summary,.field-validation { color:#ffabb5; font-size:.8rem; }.validation-summary ul { margin:0 0 14px; padding-left:18px; }.field-validation { display:block; margin-top:5px; }.notice { margin:0 0 20px; padding:12px 15px; border-radius:7px 18px 18px 7px; }.notice.success { border:1px solid rgba(101,230,163,.35); color:#c8ffe0; background:rgba(101,230,163,.09); }.details-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:16px; margin-bottom:18px; }.detail-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; margin:0; }.detail-list div { min-width:0; }.detail-list dt { margin-bottom:5px; color:#7ea3c4; font:700 .67rem/1 ui-monospace,monospace; letter-spacing:.09em; text-transform:uppercase; }.detail-list dd { margin:0; color:#e7f3ff; }.status-form { display:grid; gap:12px; }.status-form .btn { justify-self:start; margin-top:4px; }.asset-status { display:inline-flex; padding:5px 9px; border-radius:999px; font-size:.7rem; font-weight:750; }.asset-status.operational { color:#b7ffd7; background:rgba(101,230,163,.11); }.asset-status.attentionrequired { color:#ffe4b3; background:rgba(255,199,102,.12); }.asset-status.outofservice { color:#ffd0d6; background:rgba(255,107,122,.13); }.asset-status.retired { color:#c5cdda; background:rgba(170,181,199,.13); }.timeline-panel { margin-top:18px; }.timeline-panel .panel-head span { color:var(--muted); font-size:.78rem; }.timeline { list-style:none; display:grid; gap:17px; margin:0; padding:22px 28px; }.timeline li { position:relative; display:flex; gap:13px; }.timeline li:not(:last-child)::before { content:""; position:absolute; top:17px; bottom:-18px; left:5px; width:1px; background:var(--line); }.timeline-dot { flex:0 0 11px; width:11px; height:11px; margin-top:4px; border-radius:50%; background:var(--cyan); box-shadow:0 0 12px rgba(118,217,255,.6); }.timeline strong,.timeline small { display:block; }.timeline strong { color:#e8f6ff; font-size:.88rem; }.timeline small { margin-top:4px; color:var(--muted); font-size:.75rem; }
        @@media (max-width:1000px) { .stat-grid { grid-template-columns:repeat(2,1fr); }.quick-actions { grid-template-columns:1fr; } .details-grid { grid-template-columns:1fr; } } @@media (max-width:720px) { .shell { grid-template-columns:1fr; }.side { padding:14px; border-right:0; border-bottom:1px solid var(--line); }.brand { margin:0 0 12px; }nav { display:flex; overflow-x:auto; }nav a { white-space:nowrap; }nav a:last-child { margin:0; }.side-foot { display:none; }header { padding:13px 18px; }.header-nav>a { display:none; }.content { padding:28px 18px; }.page-head { align-items:flex-start; flex-direction:column; }.stat-grid,.form-grid,.detail-list { grid-template-columns:1fr; } }
        #nexus-intro { position: fixed; inset: 0; z-index: 9999; display: grid; place-items: center; overflow: hidden; background: #06130f; color: #d9ffe8; transition: opacity .65s ease, visibility .65s ease; }
        #nexus-intro::before { content: ""; position: absolute; inset: -50%; background: repeating-linear-gradient(90deg, transparent 0 46px, rgba(84,255,164,.035) 47px 48px), repeating-linear-gradient(0deg, transparent 0 46px, rgba(84,255,164,.035) 47px 48px); transform: perspective(500px) rotateX(58deg) translateY(17%); }
        #nexus-intro.is-leaving { opacity: 0; visibility: hidden; }
        .intro-content { position: relative; z-index: 1; text-align: center; }
        .intro-cubes { display: grid; grid-template-columns: repeat(5, 28px); gap: 8px; justify-content: center; margin: 0 auto 28px; }
        .intro-cube { width: 28px; height: 28px; border: 1px solid rgba(144,255,192,.4); background: rgba(13,70,45,.35); box-shadow: 0 0 0 transparent; opacity: 0; transform: translateY(-95px) rotate(24deg) scale(.3); animation: cube-assemble .65s cubic-bezier(.2,.85,.35,1) forwards; }
        .intro-cube:nth-child(5n + 3) { background: #30d675; border-color: #b2ffd1; }
        .intro-cube:nth-child(7n) { background: #a2ffbd; }
        .intro-wordmark { margin: 0; font: 700 clamp(2rem, 7vw, 4rem)/1 system-ui, sans-serif; letter-spacing: -.07em; opacity: 0; animation: intro-reveal .7s .75s forwards; }
        .intro-wordmark span { color: #57ed94; }
        .intro-status { margin: 13px 0 0; font: 600 .72rem/1.2 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .14em; text-transform: uppercase; color: #7bbf96; opacity: 0; animation: intro-reveal .5s 1.2s forwards; }
        .intro-scan { width: min(300px, 72vw); height: 2px; margin: 22px auto 0; overflow: hidden; background: rgba(108,255,160,.14); }
        .intro-scan::after { content: ""; display: block; width: 35%; height: 100%; background: #61ff9d; box-shadow: 0 0 13px #61ff9d; animation: scan 1.1s 1s ease-in-out infinite; }
        @@keyframes cube-assemble { to { opacity: 1; transform: translateY(0) rotate(0) scale(1); box-shadow: 0 0 20px rgba(75,255,145,.2); } }
        @@keyframes intro-reveal { to { opacity: 1; } }
        @@keyframes scan { from { transform: translateX(-120%); } to { transform: translateX(360%); } }
        @@media (prefers-reduced-motion: reduce) { #nexus-intro { display: none; } }
    </style>
</head>
<body>
    <div id="nexus-intro" aria-label="NexusOps se učitava" role="status">
        <div class="intro-content">
            <div class="intro-cubes" aria-hidden="true">
                @for (var cube = 0; cube < 25; cube++) { <i class="intro-cube" style="animation-delay:@(cube * 42)ms"></i> }
            </div>
            <p class="intro-wordmark">Nexus<span>Ops</span></p>
            <p class="intro-status">Operational system loading</p>
            <div class="intro-scan" aria-hidden="true"></div>
        </div>
    </div>

    <div class="shell">
        <aside class="side">
            <a class="brand" asp-page="/Index"><b>N</b>NexusOps</a>
            <nav>
                <a asp-page="/Index">◈ Nadzorna ploča</a>
                <a asp-page="/WorkOrders/Index">✓ Radni nalozi</a>
                <a asp-page="/Assets/Index">▣ Strojevi</a>
                <a asp-page="/Reports/Index">◫ Izvještaji</a>
                <a href="/command-center">☎ Voice Command Center</a>
            </nav>
            <div class="side-foot">NexusOps v0.1<br /><span>Razvojno okruženje</span></div>
        </aside>
        <main>
            <header>
                <div class="header-nav"><button type="button" class="back-button" onclick="history.back()">← Natrag</button><a asp-page="/Index">Nadzorna ploča</a></div>
                <div><span>Organizacija: <strong>Demo pogon</strong></span><span class="user">Administrator</span></div>
            </header>
            <div class="content">@RenderBody()</div>
        </main>
    </div>
    <script>
        (() => {
            const intro = document.getElementById('nexus-intro');
            if (!intro) return;
            if (sessionStorage.getItem('nexusops-intro-seen')) { intro.remove(); return; }
            sessionStorage.setItem('nexusops-intro-seen', 'true');
            window.setTimeout(() => intro.classList.add('is-leaving'), 2600);
            window.setTimeout(() => intro.remove(), 3300);
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
