<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · NexusOps</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        #nexus-intro { position: fixed; inset: 0; z-index: 9999; display: grid; place-items: center; overflow: hidden; background: #06130f; color: #d9ffe8; transition: opacity .65s ease, visibility .65s ease; }
        #nexus-intro::before { content: ""; position: absolute; inset: -50%; background: repeating-linear-gradient(90deg, transparent 0 46px, rgba(84,255,164,.035) 47px 48px), repeating-linear-gradient(0deg, transparent 0 46px, rgba(84,255,164,.035) 47px 48px); transform: perspective(500px) rotateX(58deg) translateY(17%); }
        #nexus-intro.is-leaving { opacity: 0; visibility: hidden; }
        .intro-content { position: relative; z-index: 1; text-align: center; }
        .intro-cubes { display: grid; grid-template-columns: repeat(5, 28px); gap: 8px; justify-content: center; margin: 0 auto 28px; }
        .intro-cube { width: 28px; height: 28px; border: 1px solid rgba(144,255,192,.4); background: rgba(13,70,45,.35); box-shadow: 0 0 0 transparent; opacity: 0; transform: translateY(-95px) rotate(24deg) scale(.3); animation: cube-assemble .65s cubic-bezier(.2,.85,.35,1) forwards; }
        .intro-cube:nth-child(5n + 3) { background: #30d675; border-color: #b2ffd1; }
        .intro-cube:nth-child(7n) { background: #a2ffbd; }
        .intro-wordmark { margin: 0; font: 700 clamp(2rem, 7vw, 4rem)/1 system-ui, sans-serif; letter-spacing: -.07em; opacity: 0; animation: intro-reveal .7s .75s forwards; }
        .intro-wordmark span { color: #57ed94; }
        .intro-status { margin: 13px 0 0; font: 600 .72rem/1.2 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .14em; text-transform: uppercase; color: #7bbf96; opacity: 0; animation: intro-reveal .5s 1.2s forwards; }
        .intro-scan { width: min(300px, 72vw); height: 2px; margin: 22px auto 0; overflow: hidden; background: rgba(108,255,160,.14); }
        .intro-scan::after { content: ""; display: block; width: 35%; height: 100%; background: #61ff9d; box-shadow: 0 0 13px #61ff9d; animation: scan 1.1s 1s ease-in-out infinite; }
        @@keyframes cube-assemble { to { opacity: 1; transform: translateY(0) rotate(0) scale(1); box-shadow: 0 0 20px rgba(75,255,145,.2); } }
        @@keyframes intro-reveal { to { opacity: 1; } }
        @@keyframes scan { from { transform: translateX(-120%); } to { transform: translateX(360%); } }
        @@media (prefers-reduced-motion: reduce) { #nexus-intro { display: none; } }
    </style>
</head>
<body>
    <div id="nexus-intro" aria-label="NexusOps se učitava" role="status">
        <div class="intro-content">
            <div class="intro-cubes" aria-hidden="true">
                @for (var cube = 0; cube < 25; cube++) { <i class="intro-cube" style="animation-delay:@(cube * 42)ms"></i> }
            </div>
            <p class="intro-wordmark">Nexus<span>Ops</span></p>
            <p class="intro-status">Operational system loading</p>
            <div class="intro-scan" aria-hidden="true"></div>
        </div>
    </div>

    <div class="shell">
        <aside class="side">
            <a class="brand" asp-page="/Index"><b>N</b>NexusOps</a>
            <nav>
                <a asp-page="/Index">◈ Nadzorna ploča</a>
                <a asp-page="/WorkOrders/Index">✓ Radni nalozi</a>
                <a asp-page="/Assets/Index">▣ Strojevi</a>
                <a asp-page="/Reports/Index">◫ Izvještaji</a>
                <a href="/command-center">☎ Voice Command Center</a>
            </nav>
            <div class="side-foot">NexusOps v0.1<br /><span>Razvojno okruženje</span></div>
        </aside>
        <main>
            <header>
                <div class="header-nav"><button type="button" class="back-button" onclick="history.back()">← Natrag</button><a asp-page="/Index">Nadzorna ploča</a></div>
                <div><span>Organizacija: <strong>Demo pogon</strong></span><span class="user">Administrator</span></div>
            </header>
            <div class="content">@RenderBody()</div>
        </main>
    </div>
    <script>
        (() => {
            const intro = document.getElementById('nexus-intro');
            if (!intro) return;
            if (sessionStorage.getItem('nexusops-intro-seen')) { intro.remove(); return; }
            sessionStorage.setItem('nexusops-intro-seen', 'true');
            window.setTimeout(() => intro.classList.add('is-leaving'), 2600);
            window.setTimeout(() => intro.remove(), 3300);
        })();
    </script>
</body>
</html>
