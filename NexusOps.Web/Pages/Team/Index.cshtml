@page
@model NexusOps.Web.Pages.Team.IndexModel
@{ ViewData["Title"]="Tim danas"; }
<div class="page-head"><div><span class="eyebrow">Ljudi i dostupnost</span><h1>Tim danas</h1><p>Operativni pregled rada, fokusa i dostupnosti zaposlenika.</p></div></div>
@if(TempData["Success"] is string success){<div class="notice success">✓ @success</div>}
<section class="panel table-panel"><div class="panel-head"><h2>Trenutačni statusi</h2><span>@Model.Members.Count članova</span></div><div class="table-wrap"><table><thead><tr><th>Zaposlenik</th><th>Status</th><th>Gdje</th><th>Zadatak</th><th>Radni model</th><th>Početak rada</th><th></th></tr></thead><tbody>@foreach(var m in Model.Members){<tr><td><strong>@m.Name</strong><br/><small>@m.JobTitle</small></td><td><span class="tag">@m.Status @(m.DoNotDisturb?"· Ne smetaj":"")</span></td><td>@(m.Location??"—")</td><td>@(m.Task??"—")</td><td>@m.WorkMode</td><td>@(m.ClockedInAt?.LocalDateTime.ToString("HH:mm")??"—")</td><td>@if(User.IsInRole("Administrator")||User.IsInRole("Manager")){<form method="post" asp-page-handler="Update" class="user-access-form"><input type="hidden" name="employeeId" value="@m.EmployeeId"/><select name="status"><option value="working">Radi</option><option value="focused">Fokus</option><option value="on_site">Na terenu</option><option value="remote">Od kuće</option><option value="break">Pauza</option><option value="on_leave">Godišnji</option><option value="off_duty">Ne radi</option></select><input type="hidden" name="location" value="@m.Location"/><input type="hidden" name="task" value="@m.Task"/><input type="hidden" name="doNotDisturb" value="false"/><button class="btn secondary-btn">Status</button></form><form method="post" asp-page-handler="@(m.ClockedInAt is null ? "Start" : "End")" class="user-access-form"><input type="hidden" name="employeeId" value="@m.EmployeeId"/><button class="btn btn-primary">@(m.ClockedInAt is null ? "Počni rad" : "Završi rad")</button></form>}</td></tr>}</tbody></table></div></section>
