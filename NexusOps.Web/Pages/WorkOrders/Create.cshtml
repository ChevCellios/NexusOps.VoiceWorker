@page
@model NexusOps.Web.Pages.WorkOrders.CreateModel
@{ ViewData["Title"]="Novi radni nalog"; }
<div class="page-head"><div><span class="eyebrow">Održavanje</span><h1>Novi radni nalog</h1><p>Unesi zahtjev za servis ili intervenciju.</p></div></div>
<section class="panel" style="padding:24px;max-width:760px"><form method="post"><p><label asp-for="Input.Title">Naziv</label><br><input asp-for="Input.Title" style="width:100%;padding:10px"></p><p><label asp-for="Input.AssetId">Stroj</label><br><select asp-for="Input.AssetId" style="width:100%;padding:10px">@foreach(var asset in Model.Assets){<option value="@asset.Id">@asset.Code — @asset.Name</option>}</select></p><p><label asp-for="Input.Priority">Prioritet</label><br><select asp-for="Input.Priority" style="width:100%;padding:10px" asp-items="Html.GetEnumSelectList<NexusOps.Web.Models.WorkOrderPriority>()"></select></p><p><label asp-for="Input.AssignedTo">Dodijeljeno</label><br><input asp-for="Input.AssignedTo" style="width:100%;padding:10px" placeholder="Npr. Ana Kovač"></p><p><label asp-for="Input.Description">Opis</label><br><textarea asp-for="Input.Description" style="width:100%;min-height:100px;padding:10px"></textarea></p><button class="btn btn-primary">Spremi radni nalog</button></form></section>
