{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Twilio": {
    "AccountSid": "YOUR_TWILIO_ACCOUNT_SID",
    "AuthToken": "YOUR_TWILIO_AUTH_TOKEN",
    "FromPhoneNumber": "+10000000000",
    "PublicBaseUrl": "https://voice.example.com",
    "MediaStreamUrl": "wss://voice.example.com/voice/media"
  },
  "OpenAI": {
    "ApiKey": "YOUR_OPENAI_API_KEY",
    "RealtimeModel": "gpt-realtime-1.5",
    "RealtimeEndpoint": "wss://api.openai.com/v1/realtime",
    "Voice": "alloy",
    "Instructions": "Govori hrvatski, budi jasan i sažet. Ne izvršavaj poslovne radnje bez potvrde korisnika.",
    "TranscriptionModel": "gpt-4o-mini-transcribe",
    "TranscriptionLanguage": "hr"
  },
  "Persistence": {
    "Provider": "PostgreSql"
  },
  "SupabaseAuth": {
    "Enabled": false,
    "RequireAuthenticatedUsers": false,
    "Url": "https://YOUR_PROJECT.supabase.co",
    "PublishableKey": "YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"
  },
  "AllowedHosts": "*"
